---
/**
 * Background music player: looping track with a spinning vinyl-style toggle
 * pinned to the bottom-left corner of every invitation page.
 */
import audioUrl from "../assets/audio.mp3?url";
---

<div class="music" data-music>
  <audio class="music__audio" data-music-audio src={audioUrl} loop preload="none"></audio>

  <button
    class="music__btn"
    type="button"
    data-music-toggle
    aria-label="Reproducir o pausar la m&uacute;sica"
    aria-pressed="false"
  >
    <span class="music__disc" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 3 v10.55 A4 4 0 1 0 14 17 V7 h4 V3 Z"></path>
      </svg>
    </span>
  </button>
</div>

<style>
  .music {
    position: fixed;
    left: clamp(0.8rem, 3vw, 1.4rem);
    bottom: calc(clamp(0.8rem, 3vw, 1.4rem) + env(safe-area-inset-bottom));
    z-index: 80;
  }

  .music__btn {
    position: relative;
    width: clamp(46px, 12vw, 58px);
    aspect-ratio: 1;
    padding: 0;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    display: grid;
    place-items: center;
    background: radial-gradient(circle at 32% 28%, #efd68a 0%, #d4af37 48%, #a97e1c 100%);
    box-shadow:
      0 10px 24px -10px rgb(0 0 0 / 0.7),
      inset 0 2px 4px rgb(255 255 255 / 0.45),
      inset 0 -3px 6px rgb(90 60 0 / 0.4);
    transition: transform 0.15s ease, filter 0.25s ease;
  }

  .music__btn:hover {
    filter: brightness(1.07);
  }

  .music__btn:active {
    transform: scale(0.94);
  }

  /* Paused cue: small coral dot on the rim */
  .music:not(.is-playing) .music__btn::after {
    content: "";
    position: absolute;
    top: 2px;
    right: 2px;
    width: 11px;
    height: 11px;
    border-radius: 9999px;
    background: #e07a5f;
    border: 2px solid var(--color-navy-deep);
  }

  /* Vinyl disc with grooves; spins only while playing */
  .music__disc {
    width: 74%;
    aspect-ratio: 1;
    border-radius: 9999px;
    display: grid;
    place-items: center;
    background: repeating-radial-gradient(
      circle at 50% 50%,
      rgb(11 31 58 / 0.92) 0 2px,
      rgb(22 48 90 / 0.92) 2px 4px
    );
    box-shadow: inset 0 0 0 1.5px rgb(230 201 106 / 0.5);
    animation: disc-spin 5.5s linear infinite;
    animation-play-state: paused;
  }

  .music.is-playing .music__disc {
    animation-play-state: running;
  }

  .music__disc svg {
    width: 52%;
    height: 52%;
    color: var(--color-gold-light);
  }

  @keyframes disc-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .music__disc {
      animation: none;
    }
  }
</style>

<script>
  import { initMusicPlayer } from "../scripts/musicPlayer";
  initMusicPlayer();
</script>
