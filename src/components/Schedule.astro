---
/**
 * Section 3 — Day schedule: ceremony and reception times, plus venue map.
 * Warm canvas echoing the hero, with a golden timeline that draws itself
 * on scroll and interactive event cards.
 */

// Placeholder venue — edit these once confirmed
const VENUE_NAME = "Hacienda La Esperanza";
const ADDRESS = "Cali, Valle del Cauca, Colombia";
const LAT = 3.4516;
const LNG = -76.532;
const MAPS_URL = `https://www.google.com/maps/search/?api=1&query=${LAT},${LNG}`;
const MAPS_EMBED_URL = `https://maps.google.com/maps?q=${LAT},${LNG}&z=14&output=embed`;
---

<section id="cronograma" class="schedule" aria-label="Cronograma de la boda">
  <!-- Gold ornament marking the section boundary -->
  <div class="schedule__edge" aria-hidden="true"><span></span><i></i><span></span></div>

  <div class="schedule__wash" aria-hidden="true"></div>

  <div class="schedule__content">
    <p class="schedule__eyebrow" data-schedule-animate>El itinerario</p>

    <h2 class="schedule__title" data-schedule-animate>Cronograma</h2>

    <div class="schedule__divider" data-schedule-animate aria-hidden="true">
      <span></span><i></i><span></span>
    </div>

    <ol class="timeline">
      <!-- Spine draws itself on scroll -->
      <span class="timeline__line" data-timeline-line aria-hidden="true"></span>

      <li class="event">
        <div class="event__node" data-event-node aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Wedding rings -->
            <circle cx="9.5" cy="13.5" r="5.5"></circle>
            <circle cx="14.5" cy="10.5" r="5.5"></circle>
            <path d="M17.8 2.8 l2.4 2.4 -2.4 2.4 -2.4 -2.4 Z"></path>
          </svg>
        </div>

        <article class="event__card" data-event-card>
          <span class="event__time">4:00 PM</span>
          <h3 class="event__name">Ceremonia</h3>
          <p class="event__detail">Prometemos nuestro amor ante Dios y los nuestros.</p>
        </article>
      </li>

      <li class="event">
        <div class="event__node" data-event-node aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Celebration notes -->
            <circle cx="8" cy="17.5" r="2.4"></circle>
            <circle cx="16.5" cy="15.5" r="2.4"></circle>
            <path d="M10.4 17.5 V6.2 L18.9 4.4 V15.5"></path>
          </svg>
        </div>

        <article class="event__card" data-event-card>
          <span class="event__time">6:00 PM</span>
          <h3 class="event__name">Recepci&oacute;n</h3>
          <p class="event__detail">Brindis, cena y baile para celebrar juntos.</p>
        </article>
      </li>
    </ol>

    <!-- Venue location -->
    <div class="location">
      <div class="location__head" data-location-animate>
        <svg class="location__pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 21 s-7 -5.4 -7 -11 a7 7 0 1 1 14 0 c0 5.6 -7 11 -7 11 Z"></path>
          <circle cx="12" cy="9.6" r="2.6"></circle>
        </svg>
        <h3 class="location__name">{VENUE_NAME}</h3>
        <p class="location__address">{ADDRESS}</p>
      </div>

      <div class="location__map" data-location-animate>
        <iframe
          title={`Mapa: ${VENUE_NAME}`}
          src={MAPS_EMBED_URL}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <a class="location__cta" data-location-animate href={MAPS_URL} target="_blank" rel="noopener noreferrer">
        Abrir en Google Maps
      </a>
    </div>
  </div>
</section>

<style>
  .schedule {
    position: relative;
    min-height: 100dvh;
    min-height: 100lvh;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: linear-gradient(180deg, #fdf9f0 0%, #f7efdc 58%, #f0e3c6 100%);
  }

  /* Boundary ornament */
  .schedule__edge {
    position: absolute;
    top: clamp(1.25rem, 4vh, 2.5rem);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .schedule__edge span {
    height: 1px;
    width: clamp(64px, 18vw, 140px);
    background: linear-gradient(90deg, transparent, rgb(201 162 39 / 0.7));
  }

  .schedule__edge span:last-child {
    background: linear-gradient(90deg, rgb(201 162 39 / 0.7), transparent);
  }

  .schedule__edge i {
    width: 7px;
    height: 7px;
    rotate: 45deg;
    background: var(--color-gold);
  }

  /* Soft blue wash for continuity with the hero */
  .schedule__wash {
    position: absolute;
    top: -22%;
    right: -18%;
    width: 55vw;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgb(47 82 138 / 0.08), transparent 70%);
    pointer-events: none;
  }

  .schedule__content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.9rem, 3vh, 1.5rem);
    padding: clamp(4rem, 12vh, 7rem) 1.5rem;
    text-align: center;
  }

  .schedule__eyebrow {
    font-size: clamp(0.72rem, 2.4vw, 0.85rem);
    font-weight: 500;
    letter-spacing: 0.42em;
    text-indent: 0.42em;
    text-transform: uppercase;
    color: #a07c17;
  }

  .schedule__title {
    font-family: var(--font-title);
    font-size: clamp(2rem, 8vw, 4rem);
    font-weight: 600;
    line-height: 1.05;
    color: var(--color-navy);
  }

  .schedule__divider {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .schedule__divider span {
    height: 1px;
    width: clamp(48px, 12vw, 96px);
    background: linear-gradient(90deg, transparent, var(--color-gold));
  }

  .schedule__divider span:last-child {
    background: linear-gradient(90deg, var(--color-gold), transparent);
  }

  .schedule__divider i {
    width: 7px;
    height: 7px;
    rotate: 45deg;
    background: var(--color-gold);
  }

  /* Timeline --------------------------------------------------------------- */
  .timeline {
    position: relative;
    width: min(100%, 720px);
    margin-top: clamp(1rem, 4vh, 2.25rem);
    list-style: none;
    padding: 0.25rem 0;
  }

  /* Golden spine */
  .timeline__line {
    position: absolute;
    top: 10px;
    bottom: 10px;
    left: 27px;
    width: 2px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      var(--color-gold) 10%,
      var(--color-gold) 90%,
      transparent 100%
    );
  }

  .event {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: clamp(0.9rem, 3vw, 1.4rem);
    align-items: center;
    padding: clamp(1rem, 3.5vh, 1.9rem) 0;
  }

  /* Node ------------------------------------------------------------------- */
  .event__node {
    position: relative;
    z-index: 2;
    grid-row: 1;
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    border-radius: 9999px;
    border: 1px solid rgb(201 162 39 / 0.65);
    background: #fdf9f0;
    color: var(--color-navy);
    box-shadow: 0 6px 18px -8px rgb(11 31 58 / 0.35);
  }

  .event__node svg {
    width: 26px;
    height: 26px;
  }

  /* Expanding halo pulse */
  .event__node::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1px solid rgb(201 162 39 / 0.55);
    animation: node-pulse 3s ease-out infinite;
  }

  .event:nth-child(odd) .event__node::after {
    animation-delay: 1.2s;
  }

  /* Card -------------------------------------------------------------------- */
  .event__card {
    grid-row: 1;
    text-align: center;
    padding: clamp(1rem, 3vw, 1.35rem) clamp(1.1rem, 3vw, 1.5rem);
    border-radius: 14px;
    border: 1px solid rgb(201 162 39 / 0.4);
    background: rgb(255 253 247 / 0.72);
    backdrop-filter: blur(6px);
    box-shadow: 0 14px 34px -18px rgb(11 31 58 / 0.35);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .event__card:hover {
    transform: translateY(-4px);
    border-color: rgb(201 162 39 / 0.85);
    box-shadow: 0 22px 44px -18px rgb(11 31 58 / 0.45);
  }

  .event__time {
    font-family: var(--font-title);
    font-size: clamp(1.5rem, 5vw, 2rem);
    font-weight: 600;
    line-height: 1;
    color: #a07c17;
    transition: color 0.25s ease;
  }

  .event__card:hover .event__time {
    color: var(--color-navy);
  }

  .event__name {
    margin-top: 0.35rem;
    font-family: var(--font-title);
    font-size: clamp(1.25rem, 4vw, 1.6rem);
    font-weight: 600;
    color: var(--color-navy);
  }

  .event__detail {
    margin-top: 0.4rem;
    margin-inline: auto;
    max-width: 38ch;
    font-size: clamp(0.85rem, 2.4vw, 0.95rem);
    font-weight: 300;
    line-height: 1.6;
    color: rgb(11 31 58 / 0.62);
  }

  /* Desktop: alternating cards around a centered spine ---------------------- */
  @media (min-width: 768px) {
    .timeline__line {
      left: 50%;
      margin-left: -1px;
    }

    .event {
      grid-template-columns: 1fr 96px 1fr;
    }

    .event__node {
      grid-column: 2;
      justify-self: center;
    }

    .event:nth-child(odd) .event__card {
      grid-column: 1;
      justify-self: end;
    }

    .event:nth-child(even) .event__card {
      grid-column: 3;
      justify-self: start;
    }
  }

  /* Location ----------------------------------------------------------------- */
  .location {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1rem, 3vh, 1.5rem);
    margin-top: clamp(2rem, 6vh, 3.5rem);
  }

  .location__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .location__pin {
    width: 26px;
    height: 26px;
    color: #a07c17;
  }

  .location__name {
    font-family: var(--font-title);
    font-size: clamp(1.5rem, 5vw, 2rem);
    font-weight: 600;
    color: var(--color-navy);
  }

  .location__address {
    font-size: clamp(0.85rem, 2.4vw, 0.95rem);
    font-weight: 300;
    letter-spacing: 0.08em;
    color: rgb(11 31 58 / 0.62);
  }

  .location__map {
    width: min(100%, 520px);
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgb(201 162 39 / 0.45);
    box-shadow: 0 18px 40px -20px rgb(11 31 58 / 0.45);
    line-height: 0;
  }

  .location__map iframe {
    width: 100%;
    height: clamp(210px, 32vh, 280px);
    border: 0;
    filter: grayscale(0.35) sepia(0.14) saturate(0.9);
    transition: filter 0.35s ease;
  }

  .location__map:hover iframe,
  .location__map:focus-within iframe {
    filter: none;
  }

  .location__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.6rem;
    border-radius: 9999px;
    border: 1px solid rgb(201 162 39 / 0.65);
    color: var(--color-navy);
    background: rgb(255 253 247 / 0.7);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-indent: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .location__cta:hover,
  .location__cta:focus-visible {
    background: var(--color-gold);
    color: #fdf9f0;
    box-shadow: 0 12px 26px -12px rgb(160 124 23 / 0.8);
  }

  @media (prefers-reduced-motion: reduce) {
    .location__map iframe,
    .location__cta {
      transition: none;
    }
  }

  @keyframes node-pulse {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    70%,
    100% {
      transform: scale(1.65);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event__node::after {
      animation: none;
    }

    .event__card,
    .event__time {
      transition: none;
    }
  }
</style>
